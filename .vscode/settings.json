{
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "editor.formatOnType": false, // required
  "editor.formatOnPaste": true, // optional
  "editor.formatOnSave": true, // optional
  "editor.formatOnSaveMode": "file", // required to format on save
  "files.autoSave": "onFocusChange", // optional but recommended
  "vs-code-prettier-eslint.prettierLast": false,
  "chat.tools.terminal.autoApprove": {
    "/^Move-Item -LiteralPath 'public\\\\coming-soon\\\\Groove Garden - Whistle Fiesta\\.png' -Destination 'public\\\\past-flyers\\\\Groove Garden - Whistle Fiesta\\.png'; if \\(Test-Path -LiteralPath 'public\\\\past-flyers\\\\Groove Garden - Whistle Fiesta\\.png'\\) \\{ Write-Output 'Archived Whistle Fiesta flyer\\.' \\} else \\{ throw 'Flyer archive move failed\\.' \\}$/": {
      "approve": true,
      "matchCommandLine": true
    }
  } // set as "true" to run 'prettier' last not first
}