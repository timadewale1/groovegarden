

# Supabase project settings; the service role key must remain server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Configure the actual event before enabling sales
TICKET_EVENT_NAME=Groove Garden Carnival 2026
TICKET_EVENT_DATE=2026-11-30
TICKET_EVENT_TIME=9 PM till Sunrise
TICKET_PRICE_NGN=3000

# Existing Gmail mailer settings
GG_MAIL_USER=your-mailbox@gmail.com
GG_MAIL_PASS=replace_me
GG_MAIL_RECEIVER=your-admin-mailbox@example.com

# Staff ticket verification (server-side only)
TICKET_VERIFY_LOGIN_CODE=12312345
TICKET_VERIFY_SESSION_SECRET=generate_a_random_secret_at_least_32_characters_long
